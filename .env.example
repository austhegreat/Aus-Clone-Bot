# Aus Clone Bot — Environment Configuration Template
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Telegram Bot Credentials
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHANNEL_URL=https://t.me/aus_updates
TELEGRAM_WEBHOOK_SECRET=your_secret_webhook_token_here

# Default Card Provisioning Settings
DEFAULT_REGION=Australia (AU)
DEFAULT_PLAN=Premium Ultra HD (4K)
SESSION_DURATION_HOURS=48

# Observable Device Launch URLs (Configurable destinations)
PC_LOGIN_URL=http://localhost:3000/preview/pc
MOBILE_LOGIN_URL=http://localhost:3000/preview/mobile
TV_LOGIN_URL=http://localhost:3000/preview/tv

# Admin Panel Authorization
ADMIN_SECRET=admin123

# Database & Storage
DATA_DIR=./data
# For PostgreSQL deployment:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aus_clone_bot
